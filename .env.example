# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL / SQLite persistent layer)
DATABASE_URL="postgresql://user:password@localhost:5432/storeflex"

# Authentication Secret
AUTH_SECRET="your-jwt-auth-secret-storeflex-2026"

# Payment Gateway (Razorpay key credentials)
PAYMENT_KEY="rzp_test_placeholder_key"

# Maps Provider (Google Maps or OpenStreetMap)
MAPS_KEY="placeholder_maps_api_key"

# Object Storage (S3 / GCS / Replit Object Storage)
STORAGE_KEY="placeholder_storage_access_key"

# Transactional Notifications (Email / SMS / WhatsApp)
EMAIL_KEY="placeholder_resend_or_smtp_key"

# AI Assisted Engine
AI_API_KEY="placeholder_gemini_api_key"

